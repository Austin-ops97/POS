# ─── Required for production ─────────────────────────────────────────────────
# Copy to .env and fill in real values.

# PostgreSQL — Neon requires two URLs:
#
# DATABASE_URL: pooled connection used by the running Next.js application.
# DIRECT_URL: non-pooled connection used by Prisma migrations / schema CLI.
# Username, password, database name, and query params should match.
# The DIRECT_URL hostname must NOT contain "-pooler".
#
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Clerk Authentication (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Comma-separated service-owner emails that receive /admin platform access.
PLATFORM_ADMIN_EMAILS=owner@example.com
# Second gate for /admin/builder. At least 16 characters. Never use a NEXT_PUBLIC_ name.
BUILDER_UNLOCK_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Local-only single-user auth when Clerk keys are unset. Never enable in production.
# ALLOW_DEV_AUTH_BYPASS=true

# Stripe (https://dashboard.stripe.com) — merchant payments via Connect
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional: only needed if you prefer a build-time client env var
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Configure webhook endpoint: /api/webhooks/stripe
# Connect/payment events: payment_intent.*, charge.refunded, account.updated
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# Public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: error monitoring
# SENTRY_DSN=https://...@sentry.io/...

# Optional: multi-instance rate limiting (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# Optional: signing secret for register cashier cookies (falls back to CLERK_SECRET_KEY)
# REGISTER_CASHIER_SECRET=long-random-string

# Optional: barcode / external product lookup
PRODUCT_LOOKUP_ENABLED=true
PRODUCT_LOOKUP_USER_AGENT="EmeraldOne/0.1.0 (support@your-domain.com)"
PRODUCT_LOOKUP_CACHE_DAYS=30

# Optional: expense receipt blob storage path (defaults to .data/receipts)
# RECEIPT_STORAGE_PATH=/var/data/nexapos/receipts

# Transactional email for receipts and project reminder alerts (https://resend.com)
RESEND_API_KEY=re_...
RECEIPTS_FROM_EMAIL="EmeraldOne <receipts@yourdomain.com>"
RECEIPTS_REPLY_TO_EMAIL=support@yourdomain.com
# Optional sender used by Office communication drafts and project reminder emails
# (falls back to RECEIPTS_FROM_EMAIL). Required, with RESEND_API_KEY, for reminder alerts.
OFFICE_FROM_EMAIL="EmeraldOne <office@yourdomain.com>"

# Cron auth for /api/cron/reminders and /api/cron/pto-accrual (Authorization: Bearer …)
# Vercel Cron sends this header automatically when CRON_SECRET is set.
# /api/cron/reminders must run on a short cadence (every 5 minutes) so due
# project reminders can create in-app notifications and send email alerts.
CRON_SECRET=replace-with-long-random-string

# Vercel Blob for project completion photos
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# LiveKit Cloud (or self-hosted) for Connections video/audio calling
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
LIVEKIT_URL=wss://your-app.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-app.livekit.cloud

# Master key for the Builder platform credential vault. 32 random bytes, base64-encoded.
# openssl rand -base64 32
# Meta, LinkedIn, Plaid, and Intuit app secrets are saved in Builder and encrypted with this key.
# Keep this one key in the host. Do not treat the provider secrets below as the place to edit them.
# CREDENTIALS_ENCRYPTION_KEY=

# Optional host fallbacks. Prefer Builder → Platform credentials. A vault value wins over these.
# QuickBooks Online — official Intuit OAuth.
# Redirect URI must match the Intuit app exactly, for example:
# http://localhost:3000/api/integrations/quickbooks/callback
# INTUIT_ENVIRONMENT=sandbox
# INTUIT_CLIENT_ID=
# INTUIT_CLIENT_SECRET=
# INTUIT_REDIRECT_URI=http://localhost:3000/api/integrations/quickbooks/callback
# 32 random bytes, base64-encoded. Used only to encrypt OAuth tokens at rest.
# Generated into the vault on the first Intuit save when this is unset.
# INTUIT_TOKEN_ENCRYPTION_KEY=

# Plaid bank link. EmeraldOne never stores bank passwords.
# Enter the client id, secret, environment, and OAuth redirect in Builder → Platform credentials.
# These commented lines are a host fallback only. A vault value wins. Connect bank does not need them in Vercel.
# PLAID_ENV=sandbox
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# Must end with /settings/integrations/banking. https, or http://localhost. Allowlist it in the Plaid dashboard.
# PLAID_REDIRECT_URI=http://localhost:3000/settings/integrations/banking
# Optional override. Otherwise https://$NEXT_PUBLIC_APP_URL/api/webhooks/plaid is used when the app URL is https.
# PLAID_WEBHOOK_URL=
# 32 random bytes, base64-encoded. Generated into the vault on the first Plaid save when this is unset.
# PLAID_TOKEN_ENCRYPTION_KEY=

# Social publishing — official Meta and LinkedIn OAuth.
# Enter the app id and secret in Builder → Platform credentials.
# These commented lines are a host fallback only. A vault value wins. Connect does not need them in Vercel.
# The first Meta or LinkedIn save stores the redirect and generates SOCIAL_TOKEN_ENCRYPTION_KEY.
# Register the redirect in the provider console before Connect:
#   Meta, Facebook Login → Settings → Valid OAuth Redirect URIs:
#     https://<app>/api/integrations/meta/callback
#   LinkedIn, Auth → Authorized redirect URLs:
#     https://<app>/api/integrations/linkedin/callback
# Instagram uses the Meta callback during Facebook Login. Page linking returns the professional account.
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=http://localhost:3000/api/integrations/meta/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=http://localhost:3000/api/integrations/linkedin/callback
# 32 random bytes, base64-encoded. Encrypts Facebook, Instagram, and LinkedIn tokens.
# Generated into the vault on the first Meta or LinkedIn save when this is unset.
# SOCIAL_TOKEN_ENCRYPTION_KEY=
# Instagram image posts need a public URL. That uses the BLOB_READ_WRITE_TOKEN already listed above.
# Digital business card logos use the same token when it is set. Without it, the logo is stored with the card.

# Apple Wallet passes for Office → Digital Business Cards.
# Create a Pass Type ID, export the certificate and private key as a .p12, and download the Apple WWDR G4 intermediate as PEM.
# The pass QR opens the public card page. It does not add a contact; the visitor taps Save to Contacts.
# Leave these unset to show setup instructions in the card editor instead of a broken .pkpass download.
# PASSKIT_PASS_TYPE_IDENTIFIER=pass.com.yourcompany.emeraldone.card
# PASSKIT_TEAM_IDENTIFIER=ABCDE12345
# Base64 of the .p12 file: base64 -i pass-cert.p12
# PASSKIT_CERT_P12_BASE64=
# PASSKIT_CERT_PASSPHRASE=
# PEM, PEM with literal \n escapes, or base64 of the PEM text.
# PASSKIT_WWDR_PEM=
